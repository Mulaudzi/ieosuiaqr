# Application
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
AUTH_ISSUER=https://auth.ieosuia.com
AUTH_CLIENT_ID=qr-web
AUTH_REDIRECT_URI=https://qr.ieosuia.com/api/auth/ieosuia/callback

# Database
DB_HOST=127.0.0.1
DB_NAME=ieosuia_qr
DB_USER=ieosuia_qr
DB_PASS=change-me

# Authentication - generate at least 32 random bytes
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=qr.ieosuia.com
JWT_EXPIRY=3600
CRON_API_KEY=change-me-to-a-separate-random-secret

# Email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=IEOSUIA QR

# Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEOIP_DB_PATH=

# Writable server paths
EXPORT_PATH=
