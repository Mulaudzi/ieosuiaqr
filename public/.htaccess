Options -MultiViews

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

RewriteEngine On

# Central identity entry points: redirect before the React shell can render.
RewriteRule ^login/?$ /api/auth/ieosuia/start [R=302,L,NE]
RewriteRule ^signup/?$ /api/auth/ieosuia/start?screen_hint=signup [R=302,L,NE]
RewriteRule ^register/?$ /api/auth/ieosuia/start?screen_hint=signup [R=302,L,NE]
RewriteRule ^admin/login/?$ /api/auth/ieosuia/start?account_type=admin [R=302,L,NE]

# Keep the conventional favicon URL branded while allowing cache-busting.
RewriteRule ^favicon\.ico$ /ieosuia-qr-favicon-v2.png [R=302,L,NE]

# Built assets must be served as real files. Returning index.html for a
# missing JavaScript chunk causes strict MIME-type errors in browsers.
RewriteRule ^assets/ - [L]

# Let the API handle its own routing.
RewriteRule ^api(?:/|$) - [L]

# One canonical public URL form: no trailing slash except the origin root.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Public information routes have build-time HTML with route-specific metadata
# and content. React takes over after the initial document is parsed.
RewriteRule ^(solutions|features|dynamic-qr-codes|qr-code-generator-south-africa|branded-qr-codes|qr-analytics|inventory-qr-codes|use-cases|pricing|faq|popia-compliance|docs|privacy|terms|cookies|support|contact|careers)$ $1.html [L]
RewriteRule ^solutions/([^/]+)$ solutions-$1.html [L]

# React client-side routing: only fall back for paths that are not files.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
    # Always revalidate the application shell so it references the current
    # content-hashed JavaScript and CSS files after a deployment.
    <FilesMatch "^(?:index|solutions(?:-[a-z0-9-]+)?|features|dynamic-qr-codes|qr-code-generator-south-africa|branded-qr-codes|qr-analytics|inventory-qr-codes|use-cases|pricing|faq|popia-compliance|docs|privacy|terms|cookies|support|contact|careers)\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Vite asset filenames are content-hashed and safe to cache permanently.
    <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
