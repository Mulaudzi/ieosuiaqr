Options -MultiViews

RewriteEngine On

# Central identity entry points: redirect before the React shell can render.
RewriteRule ^login/?$ /api/auth/ieosuia/start [R=302,L,NE]
RewriteRule ^signup/?$ /api/auth/ieosuia/start?screen_hint=signup [R=302,L,NE]
RewriteRule ^admin/login/?$ /api/auth/ieosuia/start?account_type=admin [R=302,L,NE]

# Built assets must be served as real files. Returning index.html for a
# missing JavaScript chunk causes strict MIME-type errors in browsers.
RewriteRule ^assets/ - [L]

# Let the API handle its own routing.
RewriteRule ^api(?:/|$) - [L]

# React client-side routing: only fall back for paths that are not files.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
    # Always revalidate the application shell so it references the current
    # content-hashed JavaScript and CSS files after a deployment.
    <FilesMatch "^(index\.html)?$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Vite asset filenames are content-hashed and safe to cache permanently.
    <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
